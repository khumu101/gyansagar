# Copy to .env and fill in:  cp .env.example .env     (never commit .env)

# ---- required -------------------------------------------------------------
DOMAIN=gyansagar.com
DJANGO_SECRET_KEY=change-me-long-random-string       # python -c "import secrets; print(secrets.token_urlsafe(60))"
POSTGRES_PASSWORD=change-me-too
DJANGO_DEBUG=0

# first admin (created on first start; delete the password from this file afterwards)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=you@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-now

# ---- recommended ------------------------------------------------------------
ADMIN_URL=my-secret-admin-path/                      # hides /admin/ from bots
SENTRY_DSN=                                          # https://...@sentry.io/...  (free plan is enough)
SENTRY_ENVIRONMENT=production
APP_VERSION=1.0.0

# real emails (password reset). Without EMAIL_HOST, emails are only printed in the logs.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Gyansagar <no-reply@gyansagar.com>

# "Continue with Google" button (see DEPLOY.md section 9). Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- optional -----------------------------------------------------------------
ANTHROPIC_API_KEY=                                   # enables the AI Tutor
BACKUP_KEEP=14
REQUIRE_VERIFIED_EMAIL=0                             # 1 = community posts + AI Tutor need a verified e-mail (turn on once SMTP works)
REPORT_AUTOHIDE_THRESHOLD=3                          # a file reported by this many people is hidden until an admin checks it
SIGNUP_MAX_PER_HOUR=20
PASSWORD_RESET_MAX_PER_HOUR=10
PASSWORD_MIN_LENGTH=6
RESOURCE_MAX_UPLOAD_MB=100

# Uploads in S3 / Cloudflare R2 instead of the server disk (also: pip install django-storages[s3])
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
